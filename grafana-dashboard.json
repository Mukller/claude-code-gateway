# Grafana dashboard for claude-code-gateway /metrics endpoint
# Import via Grafana UI → Dashboards → Import → paste JSON
{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "Requests per minute",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "rate(ccg_total_requests_total[5m])", "legendFormat": "requests/s" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "title": "Error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "rate(ccg_total_errors_total[5m]) / rate(ccg_total_requests_total[5m]) * 100", "legendFormat": "error %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 }] } } }
    },
    {
      "title": "Token throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rate(ccg_total_input_tokens_total[5m])", "legendFormat": "input tok/s" },
        { "expr": "rate(ccg_total_output_tokens_total[5m])", "legendFormat": "output tok/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "Cost per hour (USD)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "rate(ccg_total_cost_usd_total[1h]) * 3600", "legendFormat": "$/hour" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "title": "Requests by provider",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "expr": "rate(ccg_provider_requests_total[5m])", "legendFormat": "{{provider}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "title": "Cost by provider",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{ "expr": "rate(ccg_provider_cost_usd_total[1h]) * 3600", "legendFormat": "{{provider}}" }],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "title": "Latency p50 / p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(ccg_latency_ms_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(ccg_latency_ms_bucket[5m]))", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "title": "Cache entries",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 32 },
      "targets": [{ "expr": "ccg_cache_entries", "legendFormat": "entries" }]
    },
    {
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 32 },
      "targets": [{ "expr": "ccg_uptime_seconds / 3600", "legendFormat": "hours" }],
      "fieldConfig": { "defaults": { "unit": "d" } }
    }
  ],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "title": "Claude Code Gateway"
}
